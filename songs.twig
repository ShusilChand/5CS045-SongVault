{% extends 'base.twig' %}{% block content %}<h1>{{ heading }}</h1>{% if search %}<form id="search" method="get" class="panel filters"><label>Title<input name="title" list="suggestions" value="{{ filters.title|default('') }}"><datalist id="suggestions"></datalist></label>{% for k in ['artist','album'] %}<label>{{ k|capitalize }}<input name="{{ k }}" value="{{ attribute(filters,k)|default('') }}"></label>{% endfor %}<label>Genre<select name="genre"><option value="">All genres</option>{% for g in genres %}<option {% if filters.genre|default('') == g %}selected{% endif %}>{{ g }}</option>{% endfor %}</select></label><label>Year<select name="release_year"><option value="">All years</option>{% for y in years %}<option {% if filters.release_year|default('') == y %}selected{% endif %}>{{ y }}</option>{% endfor %}</select></label><label>Sort<select name="sort">{% for k,v in {'title':'Title','artist':'Artist','year':'Newest','duration':'Duration'} %}<option value="{{ k }}" {% if filters.sort|default('title') == k %}selected{% endif %}>{{ v }}</option>{% endfor %}</select></label><button>Search</button><a href="search_song.php">Clear filters</a></form>{% endif %}<p id="status" role="status">{{ songs|length }} songs found</p><div class="tablewrap"><table><thead><tr>{% for h in ['Title','Artist','Album','Genre','Year','Duration','Actions'] %}<th>{{ h }}</th>{% endfor %}</tr></thead><tbody id="results">{% for s in songs %}<tr><td>{{ s.title|e }}</td><td>{{ s.artist|e }}</td><td>{{ s.album }}</td><td>{{ s.genre }}</td><td>{{ s.release_year }}</td><td>{{ s.duration }}</td><td><a href="edit_song.php?id={{ s.id }}">Edit</a> · <a href="delete_song.php?id={{ s.id }}">Delete</a></td></tr>{% endfor %}</tbody></table></div>{% if search %}<script src="assets/search.js" defer></script>{% endif %}{% endblock %}
