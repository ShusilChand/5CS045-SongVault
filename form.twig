{% extends 'base.twig' %}{% block content %}<section class="panel narrow"><h1>{{ heading }}</h1>{% if error %}<p role="alert">{{ error }}</p>{% endif %}<form method="post"><input type="hidden" name="csrf" value="{{ csrf }}">{% for k,v in {'title':'Title','artist':'Artist','album':'Album','genre':'Genre','release_year':'Release year','duration':'Duration (HH:MM:SS)'} %}<label>{{ v }}<input name="{{ k }}" value="{{ attribute(song,k)|default('') }}" {% if k in ['title','artist','genre','release_year'] %}required{% endif %}></label>{% endfor %}<label>Description<textarea name="description">{{ song.description|default('') }}</textarea></label><button>Save song</button></form></section>{% endblock %}
