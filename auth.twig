{% extends 'base.twig' %}{% block content %}<section class="panel narrow"><h1>{{ heading }}</h1>{% if error %}<p role="alert">{{ error }}</p>{% endif %}<form method="post"><input type="hidden" name="csrf" value="{{ csrf }}"><label>Username<input name="username" required maxlength="50" autocomplete="username"></label><label>Password<input type="password" name="password" required autocomplete="{% if register %}new-password{% else %}current-password{% endif %}"></label>{% if not register %}<label>CAPTCHA: {{ question }} = ?<input name="captcha" required inputmode="numeric"></label>{% endif %}<button>{{ heading }}</button></form></section>{% endblock %}
